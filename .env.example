# aidaily Notion Pipeline - Environment Variables
# Copy this file to .env and fill in your actual keys.

# Jina Reader API Key (https://jina.ai - free tier available)
JINA_API_KEY=your_jina_api_key_here

# Google Gemini API Key (https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here

# Notion Integration Token (https://www.notion.so/my-integrations)
NOTION_TOKEN=your_notion_integration_token_here

# Notion Database ID (from the database URL)
# Example URL: https://www.notion.so/<workspace>/<DATABASE_ID>?v=...
# Note: Use the DATABASE ID, not the page ID. If your DB is inline,
# the database ID differs from the parent page ID.
NOTION_DATABASE_ID=your_notion_database_id_here
